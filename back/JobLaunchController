	@ApiOperation(value = "0. startBatchInferenceResultJob", notes = "Helpy Struct의 추론 결과 html을 QA를 거쳐 수정된 정답 html로 AI DB에 insert 하는 Job Config (개발 단계에서만 사용. 운영에선 FileJobConfig가 반환받은 html을 DB에 바로 적재할 것임.)")
	@PostMapping("/start/inferenceResultJob")
	public ResponseEntity<InferenceResultJobResponseDto> startBatchInferenceResultJob(
			@ApiParam(value = "마스킹된 문서 경로, QA가 검토 후 변환한 jsonl 파일 경로를 List<Map<String, String>> 형태로 받음", example = "[{\"maskedFilePath\":\"C:\\\\Dev\\\\doc\\\\inferenceTest\\\\origin\\\\마스킹 파일1.xlsx\",\"jsonlFilePath\":\"C:\\\\Dev\\\\doc\\\\inferenceTest\\\\jsonl\\\\jsonlTest1.jsonl\"},{\"maskedFilePath\":\"C:\\\\Dev\\\\doc\\\\inferenceTest\\\\origin\\\\마스킹 파일2.xlsx\",\"jsonlFilePath\":\"C:\\\\Dev\\\\doc\\\\inferenceTest\\\\jsonl\\\\jsonlTest2.jsonl\"}]")
			@RequestBody List<Map<String, String>> dataList) {
		InferenceResultJobResponseDto response = new InferenceResultJobResponseDto();
		try {
			log.info("########## 배치 Job 실행 요청 수신: startBatchInferenceResultJob");
//			for (Map<String, String> items : dataList) {
//				log.info("##### dataList.get('originFilePath'): {}", items.get("originFilePath"));
//				log.info("##### dataList.get('jsonlFilePath'): {}", items.get("jsonlFilePath"));
//			}
			
			/**
			 * Job 요청 파라미터의 길이가 너무 길어져 스프링 배치 메타 데이터 테이블 중
			 * BATCH_JOB_EXECUTION_PARAMS 테이블의 STRING_VAL 컬럼에 insert 실패하는 오류 발생을 방지하기 위해
			 * 요청 데이터를 가지고 임시 json 파일을 만들고 그 파일의 절대 경로를 Job Parameter로 넘긴다.
			 * Batch Reader는 넘겨 받은 경로의 파일을 읽어 파싱한다.
			 * 배치가 끝나면 TempFileDeleteListener에서 임시 파일을 삭제 처리한다. 
			 */
			// 1. 임시 파일 경로 생성
			String tempDir = System.getProperty("java.io.tmpdir");
			String fileName = "batch_req_" + UUID.randomUUID() + ".json";
			Path filePath = Paths.get(tempDir, fileName);
			
			// 2. 파일에 JSON 데이터 쓰기
			String jsonRequest = objectMapper.writeValueAsString(dataList);
			Files.write(filePath, jsonRequest.getBytes(StandardCharsets.UTF_8));
			log.info("inferenceResultJob - 임시 요청 파일 생성됨: {}", filePath.toAbsolutePath());
			
			// 1. dataList를 Json 문자열로 직렬화
//			String jsonData = objectMapper.writeValueAsString(dataList);
			
			// JobParameters 생성
			JobParameters jobParameters = new JobParametersBuilder()
//					.addString("reqData", jsonData) // 2. JobParameters에 String 형태로 추가
					.addString("reqFilePath", filePath.toAbsolutePath().toString()) // 3. JobParameters에 파일 경로 전달
					.addLong("random", System.currentTimeMillis())
					.toJobParameters();
			
			// Job 실행
			jobLauncher.run(inferenceResultJob, jobParameters);
			response.setResult("SUCCESS");
			response.setMessage("정상적으로 수행되었습니다.");
			ResponseEntity<InferenceResultJobResponseDto> res = new ResponseEntity<InferenceResultJobResponseDto>(response, HttpStatus.OK);
			return res;
		} catch (Exception e) {
			log.error("배치 작업 실행 중 오류 발생", e);
			response.setResult("FAILED");
			response.setMessage(e.getMessage());
			ResponseEntity<InferenceResultJobResponseDto> res = new ResponseEntity<InferenceResultJobResponseDto>(response, HttpStatus.INTERNAL_SERVER_ERROR);
			return res;
		}
	}
	
